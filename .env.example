# =============================================================
# Digital Campus — Environment Configuration
# =============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# =============================================================

# ----- Application -----
APP_NAME=Digital Campus
APP_ENV=development
# development | test | production
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
RUST_LOG=digital_campus=debug,tower_http=debug

# ----- Database -----
DATABASE_URL=postgres://dc_user:dc_password@localhost:5432/digital_campus
DATABASE_MAX_CONNECTIONS=10

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- JWT / Auth -----
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ACCESS_TOKEN_EXPIRES_SECS=900
# 15 minutes
JWT_REFRESH_TOKEN_EXPIRES_SECS=604800
# 7 days

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----- Object Storage (S3-compatible) -----
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=digital-campus
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ----- Email (optional for dev) -----
# EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@digitalcampus.dev

# ----- Rate Limiting -----
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=30

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/chat/ws
NEXT_PUBLIC_APP_NAME=Digital Campus
